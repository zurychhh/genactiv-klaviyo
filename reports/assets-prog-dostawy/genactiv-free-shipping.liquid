{%- comment -%}
  GenActiv — pasek postępu do darmowej dostawy
  ============================================
  Zastępuje nieczytelny komunikat "300  141 zl PLN" w koszyku.

  ZAŁOŻENIE PROJEKTOWE: nie dotykamy skompilowanego `assets/theme-dist.js`.
  Oryginalny blok `.cart__free-shipping` zostaje w DOM i nadal jest
  przeliczany przez motyw (funkcja `_initFreeShipping`) — my go tylko
  ukrywamy wizualnie i czytamy z niego wartość przez MutationObserver.
  Dzięki temu przeliczanie przy zmianie koszyka działa bez zmian w bundlu.

  INSTALACJA:
    1. Wgraj ten plik jako  snippets/genactiv-free-shipping.liquid
    2. W  sections/cart-template.liquid  (ok. linia 452) oraz
       w  sections/cart-drawer.liquid    (ok. linia 26)
       ZOSTAW istniejący blok {% if settings.free_shipping_title ... %}
       bez zmian, a bezpośrednio PO nim dodaj:
         {% include 'genactiv-free-shipping' %}
    3. W cart-template.liquid przenieś oba te bloki tak, by znalazły się
       zaraz po elemencie `.cart-subtotal` (nad zgodą na regulamin
       i przyciskiem "DO KASY"), zamiast na końcu `.cart__summary`.
    4. Ustawienia motywu: NIC NIE TRZEBA ZMIENIAĆ.
       Snippet sam wykrywa, że `free_shipping_title` zawiera liczbę ("300")
       zamiast etykiety, i podstawia poprawny polski tekst. Jeśli ktoś
       kiedyś wpisze tam sensowną etykietę, snippet użyje jej zamiast
       wbudowanej. Dzięki temu wdrożenie nie dotyka `config/settings_data.json`
       — a to jedyny plik motywu, który bywa edytowany równolegle w Dostosuj.

  PRZED WGRANIEM: backup motywu —
    python3 shopify_theme_api.py backup 199333609804
{%- endcomment -%}

{%- assign ga_threshold = settings.cart_free_shipping_threshold | plus: 0 -%}
{%- if ga_threshold > 0 -%}
<div class="ga-fs" data-ga-fs data-ga-fs-threshold="{{ ga_threshold }}" hidden>
  <div class="ga-fs__label">
    {%- comment -%} ikony inline, dziedziczą currentColor; przełączane klasą .ga-fs--done {%- endcomment -%}
    <svg class="ga-fs__icon ga-fs__icon--todo" viewBox="0 0 24 24" width="18" height="18"
         fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/>
      <path d="M3 7.5 12 12l9-4.5M12 12v9"/>
    </svg>
    <svg class="ga-fs__icon ga-fs__icon--done" viewBox="0 0 24 24" width="18" height="18"
         fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="m8 12.3 2.6 2.6L16 9.5"/>
    </svg>
    <span data-ga-fs-text></span>
  </div>
  <div class="ga-fs__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-ga-fs-track>
    <div class="ga-fs__fill" data-ga-fs-fill></div>
  </div>
</div>

<style>
  /* oryginalny blok: zostaje w DOM (motyw go przelicza), ale niewidoczny */
  .cart__free-shipping { position: absolute !important; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0 !important; }

  .ga-fs { margin: 18px 0 20px; padding: 14px 16px; border-radius: 8px;
    background: #fdf0f1; border: 1px solid #f8ccd0; }
  .ga-fs[hidden] { display: none; }
  .ga-fs--done { background: #eaf7ef; border-color: #bfe6cd; }

  .ga-fs__label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
    font-size: 14px; line-height: 1.35; color: #1C1B1B; }
  .ga-fs__icon { flex: 0 0 auto; display: block; }
  .ga-fs__icon--todo { color: #F5333F; }
  .ga-fs__icon--done { color: #1e8449; display: none; }
  .ga-fs--done .ga-fs__icon--todo { display: none; }
  .ga-fs--done .ga-fs__icon--done { display: block; }
  .ga-fs__amount { color: #F5333F; font-weight: 700; white-space: nowrap; }
  .ga-fs--done .ga-fs__label strong { color: #1e8449; }

  .ga-fs__track { height: 8px; border-radius: 99px; background: #e8e2dd; overflow: hidden; }
  .ga-fs__fill { height: 100%; width: 0; border-radius: 99px; background: #F5333F;
    transition: width .35s ease; }
  .ga-fs--done .ga-fs__fill { background: #27ae60; }

  @media (prefers-reduced-motion: reduce) { .ga-fs__fill { transition: none; } }
</style>

<script>
(function () {
  // Etykiety z ustawień motywu, ale tylko jeśli są sensowne.
  // Dziś `free_shipping_title` = "300" (ktoś wpisał liczbę zamiast tekstu),
  // a `free_shipping_message` jest w wersalikach — oba odrzucamy.
  var FALLBACK_LEFT = 'Do darmowej dostawy brakuje Ci';
  var FALLBACK_DONE = 'Masz darmową dostawę!';

  function sane(v, fallback) {
    if (!v) return fallback;
    v = String(v).trim();
    if (!v) return fallback;
    if (/^[\d\s.,]+$/.test(v)) return fallback;          // sama liczba, np. "300"
    if (v === v.toUpperCase() && /[A-ZĄĆĘŁŃÓŚŹŻ]/.test(v)) return fallback;  // WERSALIKI
    return v;
  }

  var LABEL_LEFT = sane({{ settings.free_shipping_title | json }}, FALLBACK_LEFT);
  var LABEL_DONE = sane({{ settings.free_shipping_message | json }}, FALLBACK_DONE);

  function init(root) {
    var threshold = parseFloat(root.getAttribute('data-ga-fs-threshold'));
    // źródło prawdy: blok motywu, który przelicza się sam przy zmianie koszyka
    var src = document.querySelector('.cart__free-shipping');
    if (!src || !threshold) return;
    var srcAmount = src.querySelector('.cart__free-shipping-from');

    function render() {
      var done = !src.classList.contains('cart__free-shipping--active');
      // z "141 zl PLN" wyciągamy samo 141 — bez duplikowania waluty
      var raw = (srcAmount && srcAmount.textContent || '').replace(/[^\d.,-]/g, '').replace(',', '.');
      var left = parseFloat(raw);
      if (isNaN(left)) left = 0;

      var pct = done ? 100 : Math.max(0, Math.min(100, Math.round((threshold - left) / threshold * 100)));

      root.classList.toggle('ga-fs--done', done);
      root.querySelector('[data-ga-fs-text]').innerHTML = done
        ? '<strong>' + LABEL_DONE + '</strong>'
        : LABEL_LEFT + ' <span class="ga-fs__amount">' + Math.round(left) + ' zł</span>';

      var fill = root.querySelector('[data-ga-fs-fill]');
      fill.style.width = pct + '%';
      root.querySelector('[data-ga-fs-track]').setAttribute('aria-valuenow', pct);
      root.hidden = false;
    }

    render();
    // motyw aktualizuje blok źródłowy po każdej zmianie koszyka (AJAX) — łapiemy to
    new MutationObserver(render).observe(src, {
      childList: true, subtree: true, characterData: true,
      attributes: true, attributeFilter: ['class']
    });
  }

  function boot() {
    document.querySelectorAll('[data-ga-fs]').forEach(init);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
{%- endif -%}
