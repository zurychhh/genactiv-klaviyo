# TikTok Shop Open API — sekrety (skopiuj do .tiktok-shop.env, chmod 600, NIE commituj)
# app_key / app_secret / service_id: TikTok Shop Partner Center → strona aplikacji
TIKTOK_SHOP_APP_KEY=__APP_KEY__
TIKTOK_SHOP_APP_SECRET=__APP_SECRET__
TIKTOK_SHOP_SERVICE_ID=__SERVICE_ID__
TIKTOK_SHOP_REDIRECT_URI=https://genactiv.pl/tiktok-callback

# Uzupełniane automatycznie przez generate_tiktok_shop_token.py (po autoryzacji sklepu):
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
TIKTOK_SHOP_ACCESS_TOKEN_EXPIRE=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_ID=
