spacing=\"0\" style=\"border-collapse:collapse;border-spacing:0px;\">\n<tbody>\n<tr>\n<td class=\"kl-img-base-auto-width\" style=\"border:0;padding:0px 0px 0px 0px;width:600px;\" valign=\"top\">\n<img src=\"https://d3k81ch9hvuctc.cloudfront.net/company/RSst7h/images/8b069ddc-4efd-4ef0-93ff-f44baf4a297e.png\" style=\"display:block;outline:none;text-decoration:none;height:auto;font-size:13px;width:100%;\" width=\"600\"/>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"mj-column-per-100 mj-outlook-group-fix component-wrapper\" style=\"font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"\" style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"center\" class=\"kl-image\" style=\"font-size:0px;word-break:break-word;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;border-spacing:0px;\">\n<tbody>\n<tr>\n<td class=\"kl-img-base-auto-width\" style=\"border:0;padding:0px 0px 0px 0px;width:600px;\" valign=\"top\">\n<img src=\"https://d3k81ch9hvuctc.cloudfront.net/company/RSst7h/images/6d4a1ba8-5f55-42bf-b716-8d63a323156c.png\" style=\"display:block;outline:none;text-decoration:none;height:auto;font-size:13px;width:100%;\" width=\"600\"/>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"mj-column-per-100 mj-outlook-group-fix component-wrapper\" style=\"font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"\" style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n<tbody>\n<tr><td style=\"color:#1a1818;font-family:'Helvetica Neue', Arial;font-size:14px;line-height:1.3;\"><!-- ============================================================\n     GENACTIV — sekcja \"Ten produkt czeka w Twoim koszyku\"\n     Wariant: JEDEN PRODUKT (metryka: Added to Cart)\n     Wstawiana w szablonie \"Koszyk mail 1 — WHY\" (XnCJxJ)\n     pomiedzy grafike \"Dokoncz zamowienie\" a grafike \"70%\".\n\n     Zmienne personalizacji pochodza z produkcyjnego szablonu\n     Y2rJvV \"porzucony-koszyk-mail1-18.11 - FINAL\":\n       {{ event.URL }}                      link do PDP\n       {{ event.ImageURL }}                 zdjecie produktu\n       {{ event|lookup:'Product Name' }}    nazwa\n       {{ event.Categories.2 }}             II poziom kategorii\n       {{ event.Quantity }}                 ilosc\n       {{ event.Price }} / {{ event.CompareAtPrice }}\n       {{ event.extra.checkout_url }}       powrot do checkoutu\n     ============================================================ -->\n<div class=\"mj-column-per-100 mj-outlook-group-fix component-wrapper\" style=\"font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"gc-cart-pad\" style=\"background-color:#F03642;vertical-align:top;padding:34px 26px 38px 26px;\">\n<!-- ---------- naglowek ---------- -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td align=\"center\" class=\"gc-cart-h\" style=\"padding:0 0 26px 0;font-family:'Branding-medium',Helvetica,Arial,sans-serif;font-size:30px;line-height:1.2;font-weight:700;color:#FFFFFF;\">\nTen produkt czeka<br/>w Twoim koszyku!\n</td>\n</tr>\n</tbody>\n</table>\n<!-- ---------- biala karta produktu ---------- -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;background-color:#FFFFFF;border-radius:18px;\" width=\"100%\">\n<tbody>\n<tr>\n<td class=\"gc-card-pad\" style=\"padding:18px;\">\n<!-- table-layout:fixed - kolumny trzymaja proporcje niezaleznie od dlugosci\n     tresci; bez tego dluga nazwa produktu rozpycha tabele poza 600px -->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;table-layout:fixed;\" width=\"100%\">\n<tbody>\n<tr>\n<!-- miniatura -->\n<td class=\"gc-cart-thumb\" style=\"width:21%;padding-right:14px;\" valign=\"top\" width=\"21%\">\n<a href=\"{{ event.URL|default:'https://genactiv.pl' }}\" style=\"color:#f5333f; text-decoration:none\" target=\"_blank\">\n<img alt=\"{{ event|lookup:'Product Name'|default:'Produkt w Twoim koszyku' }}\" src=\"{{ event.ImageURL|default:'' }}\" style=\"display:block;width:100%;max-width:112px;height:auto;border:0;outline:none;text-decoration:none;border-radius:12px;background-color:#ECECEC;\"/>\n</a>\n</td>\n<!-- opis + ceny -->\n<td class=\"gc-cart-body\" style=\"width:62%;font-family:'Helvetica Neue',Arial,sans-serif;word-break:break-word;overflow-wrap:break-word;\" valign=\"top\" width=\"62%\">\n<!-- nazwa -->\n<div class=\"gc-cart-title\" style=\"font-family:'Branding-medium',Helvetica,Arial,sans-serif;font-size:17px;font-weight:700;line-height:1.3;color:#1C1B1B;padding-bottom:3px;\">\n<a href=\"{{ event.URL|default:'https://genactiv.pl' }}\" style=\"color:#1C1B1B; text-decoration:none\" target=\"_blank\">{{ event|lookup:'Product Name'|default:'Twój produkt' }}</a>\n</div>\n<!-- forma / wielkosc opakowania -->\n<!-- Jesli w evencie jest pole wariantu (np. \"120 kapsulek\"), podmien\n     event.Categories.2 na wlasciwy klucz - patrz nota w README. -->\n<div style=\"font-size:13px;line-height:1.35;color:#F03642;padding-bottom:10px;\">\n{{ event.Categories.2|default:'' }}\n</div>\n<!-- ilosc: widoczna tylko na mobile (na desktopie jest w prawej kolumnie) -->\n<div class=\"mobile-only\" style=\"display:none; font-size:12px; color:#7A7A7A; padding-bottom:8px\">\n{{ event.Quantity|floatformat:0|default:'1' }} szt.\n</div>\n\n{% if event.CompareAtPrice and event.CompareAtPrice > event.Price %}\n<!-- ---- wariant PROMOCYJNY: cena po obnizce + cena regularna + oszczednosc ---- -->\n<div style=\"padding-bottom:8px;\">\n<span class=\"gc-cart-price\" style=\"font-family:'Branding-medium',Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;color:#F03642;\">{{ event.Price|floatformat:0 }} zł</span>\n<span style=\"font-size:15px;color:#9B9B9B;text-decoration:line-through;padding-left:9px;\">{{ event.CompareAtPrice|floatformat:0 }} zł</span>\n</div>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:separate;\">\n<tbody>\n<tr>\n<td style=\"background-color:#E7F5EC;border-radius:5px;padding:5px 10px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;font-weight:700;line-height:1.35;color:#1E7A45;\">\nOszczędzasz {{ event.CompareAtPrice|minus:event.Price|floatformat:0 }} zł\n</td>\n</tr>\n</tbody>\n</table>\n{% else %}\n<!-- ---- wariant bez promocji: sama cena ---- -->\n<div>\n<span class=\"gc-cart-price\" style=\"font-family:'Branding-medium',Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;color:#F03642;\">{{ event.Price|floatformat:0 }} zł</span>\n</div>\n{% endif %}\n\n</td>\n<!-- ilosc (desktop) -->\n<td align=\"right\" class=\"desktop-only\" style=\"width:17%;font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;line-height:1.3;color:#1C1B1B;\" valign=\"top\" width=\"17%\">\n{{ event.Quantity|floatformat:0|default:'1' }} szt.\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n<!-- ---------- CTA ---------- -->\n<table align=\"center\" border=\"0\" 