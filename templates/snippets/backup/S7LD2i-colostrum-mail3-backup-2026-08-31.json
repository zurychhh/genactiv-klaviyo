                                                          {{ event.Categories.2|default:'' }}\n                                                                                  </div>\n<!-- 3. Quantity (bez przecinka) -->\n<div style=\"margin:15px 0 10px 0;\"> <span style=\"font-size:14px;color:#666;font-family:'Helvetica Neue',Arial;\">\nIlość: <strong style=\"color:#222;\">{{ event.Quantity|floatformat:0|default:'1' }}</strong>\n</span>\n</div>\n<!-- 4. Price Section z oszczędnościami -->\n                                                                                  {% if event.CompareAtPrice and event.CompareAtPrice > event.Price %}\n                                                                                  <div style=\"margin:10px 0;\"> <!-- Cena przed rabatem (przekreślona) -->\n<span style=\"text-decoration:line-through;color:#999;font-size:16px;margin-right:10px;\">{{ event.CompareAtPrice|floatformat:0 }} zł</span>\n<!-- Aktualna cena (GenActiv RED) -->\n<span style=\"color:#EF3340;font-weight:bold;font-size:22px;font-family:'Branding-medium',Helvetica,Arial,sans-serif;\">{{ event.Price|floatformat:0 }} zł</span>\n</div>\n<!-- Oszczędności -->\n<div style=\"margin:8px 0 0 0;\"> <span style=\"font-size:14px;color:#27ae60;font-weight:600;font-family:'Helvetica Neue',Arial;\">\nOszczędzasz {{ event.CompareAtPrice|minus:event.Price|floatformat:0 }} zł\n</span>\n</div>\n                                                                                  {% else %}\n                                                                                  <div style=\"margin:10px 0;\"> <!-- Normalna cena (bez przecinka) -->\n<span style=\"color:#EF3340;font-weight:bold;font-size:22px;font-family:'Branding-medium',Helvetica,Arial,sans-serif;\">{{ event.Price|floatformat:0 }} zł</span>\n</div>\n                                                                                  {% endif %}\n                                                                                <